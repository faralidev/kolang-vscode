  "snippets": [
    { "label": "تعریف", "detail": "تعریف تابع", "body": "تعریف ${1:نام}(${2:خود و پارامتر}):\n    «${3:سلام}» بنویس" },
    { "label": "تعریف-خروجی", "detail": "تابع با نوع خروجی", "body": "تعریف ${1:نام}(${2:خود و پارامتر}) -> ${3:صحیح}:\n    ${4:} برگردان" },
    { "label": "گونه", "detail": "گونه (کلاس)", "body": "گونه ${1:نام}:\n    ساخت(${2:خود و پارامتر}):\n        ${3:فیلد}ِ خود = ${3:فیلد}\n    تعریف ${4:روش}(${5:خود}):\n        «${6:صدای گونه}» بنویس" },
    { "label": "گونه-وارث", "detail": "گونه با ارث‌بری", "body": "گونه ${1:فرزند} وارث ${2:پدر}:\n    تعریف ${3:روش}(${4:خود}):\n        ${5:روش}ِ()والدِ خود" },
    { "label": "رابط", "detail": "رابط (interface)", "body": "رابط ${1:نام}:\n    تعریف ${2:روش}(${3:خود}) -> ${4:متن}:" },
    { "label": "اگر", "detail": "دستور شرطی", "body": "اگر ${1:شرط} == ${2:مقدار} باشد:\n    «${3:انجام شد}» بنویس" },
    { "label": "اگر-وگرنه", "detail": "شرطی با وگرنه", "body": "اگر ${1:شرط} == ${2:مقدار} باشد:\n    «${3:بله}» بنویس\nوگرنه:\n    «${4:خیر}» بنویس" },
    { "label": "اگر-وگرنه-اگر", "detail": "زنجیره شرطی", "body": "اگر ${1:شرط} == ${2:۱} باشد:\n    ${3:}\nوگرنه اگر ${1:شرط} == ${4:۲} باشد:\n    ${5:}\nوگرنه:\n    ${6:}" },
    { "label": "برای", "detail": "حلقه برای", "body": "برای ${1:متغیر} از ${2:۰} تا ${3:۱۰}:\n    «${4:تکرار}» بنویس" },
    { "label": "برای-گام", "detail": "حلقه با گام", "body": "برای ${1:متغیر} از ${2:۰} تا ${3:۱۰} گام ${4:۲}:\n    ${5:}" },
    { "label": "برای-در", "detail": "پیمایش فهرست", "body": "برای ${1:عنصر} در ${2:فهرست}:\n    ${1:عنصر} بنویس" },
    { "label": "تاوقتی", "detail": "حلقه تاوقتی", "body": "تاوقتی ${1:شرط} == ${2:درست} باشد:\n    ${3:}" },
    { "label": "بپا", "detail": "بلوک بپا/خطا/درنهایت", "body": "بپا:\n    ${1:عملیات خطرناک}\nخطای‌${2:صفر} بگیر:\n    «${3:خطا رخ داد}» بنویس\nدرنهایت:\n    ${4:پاک‌سازی()}" },
    { "label": "خطا-بانام", "detail": "گرفتن خطا با نام", "body": "خطای‌${1:صفر} بگیر بانام ${2:err}:\n    «${2:err}» بنویس" },
    { "label": "با", "detail": "بلوک با بازکردن", "body": "با بازکردن(${1:«مسیر فایل»}) بانام ${2:ف}:\n    ${3:محتوا} = بخوانِ()${2:ف}\n    «${3:محتوا}» بنویس" },
    { "label": "برو", "detail": "تارک (goroutine)", "body": "برو ${1:تابع}(${2:})" },
    { "label": "کانال", "detail": "ایجاد و استفاده از کانال", "body": "${1:ch} = کانال(${2:صحیح} و ${3:۱۰})\n${1:ch} << ${4:مقدار}\n${5:دریافت} = >>${1:ch}\n${1:ch} ببند" },
    { "label": "پوشش", "detail": "اعمال پوشش (decorator)", "body": "پوشش ${1:نام}\nتعریف ${2:تابع}(${3:خود}):\n    ${4:}" },
    { "label": "مولد", "detail": "تابع مولد (generator)", "body": "تعریف ${1:تولیدکننده}(${2:خود}):\n    برای ${3:ای} در ${4:داده}:\n        ${3:ای} بساز" },
    { "label": "چندمقداری", "detail": "بازگشت چندمقداری", "body": "${1:نتیجه} و ${2:خطا} = ${3:کاری}()\nاگر ${2:خطا} == تهی نباشد:\n    ${2:خطا} بده\n${1:نتیجه} برگردان" },
    { "label": "تأخیری", "detail": "اجرای تأخیری (defer)", "body": "${1:پاک‌سازی()} تأخیری" },
    { "label": "کامپرهنشن", "detail": "تولید فهرست", "body": "${1:نتیجه} = [${2:ای} * ۲ برای ${2:ای} در ${3:بازه}(۱۰)]" },
    { "label": "pipe", "detail": "زنجیره pipe", "body": "${1:داده} |> ${2:تابع۱} |> ${3:تابع۲}" },
    { "label": "بنویس", "detail": "چاپ رشته", "body": "«${1:سلام دنیا}» بنویس" }
  ]
}
