{
  "تعریف تابع": {
    "prefix": "تعریف",
    "body": [
      "تعریف ${1:نام}(${2:خود و پارامتر}):",
      "    `${3:سلام}` بنویس"
    ],
    "description": "تعریف تابع"
  },
  "تابع با خروجی": {
    "prefix": "تعریف-خروجی",
    "body": [
      "تعریف ${1:نام}(${2:خود و پارامتر}) -> ${3:صحیح}:",
      "    ${4:} برگردان"
    ],
    "description": "تعریف تابع با نوع خروجی"
  },
  "گونه (کلاس)": {
    "prefix": "گونه",
    "body": [
      "گونه ${1:نام}:",
      "    ساخت(${2:خود و پارامتر}):",
      "        ${3:فیلد}ِ خود = ${3:فیلد}",
      "    تعریف ${4:روش}(${5:خود}):",
      "        `${6:صدای گونه}` بنویس"
    ],
    "description": "تعریف گونه (کلاس)"
  },
  "گونه با ارث‌بری": {
    "prefix": "گونه-وارث",
    "body": [
      "گونه ${1:فرزند} وارث ${2:پدر}:",
      "    تعریف ${3:روش}(${4:خود}):",
      "        ${5:روش}ِ()والدِ خود"
    ],
    "description": "تعریف گونه با ارث‌بری"
  },
  "رابط": {
    "prefix": "رابط",
    "body": [
      "رابط ${1:نام}:",
      "    تعریف ${2:روش}(${3:خود}) -> ${4:متن}:"
    ],
    "description": "تعریف رابط (interface)"
  },
  "اگر": {
    "prefix": "اگر",
    "body": [
      "اگر ${1:شرط} == ${2:مقدار} باشد:",
      "    `${3:انجام شد}` بنویس"
    ],
    "description": "دستور شرطی اگر"
  },
  "اگر-وگرنه": {
    "prefix": "اگر-وگرنه",
    "body": [
      "اگر ${1:شرط} == ${2:مقدار} باشد:",
      "    `${3:بله}` بنویس",
      "وگرنه:",
      "    `${4:خیر}` بنویس"
    ],
    "description": "دستور شرطی با وگرنه"
  },
  "اگر چندگانه": {
    "prefix": "اگر-وگرنه-اگر",
    "body": [
      "اگر ${1:شرط} == ${2:۱} باشد:",
      "    ${3:}",
      "وگرنه اگر ${1:شرط} == ${4:۲} باشد:",
      "    ${5:}",
      "وگرنه:",
      "    ${6:}"
    ],
    "description": "زنجیرهٔ شرطی اگر/وگرنه اگر/وگرنه"
  },
  "برای (حلقه)": {
    "prefix": "برای",
    "body": [
      "برای ${1:متغیر} از ${2:۰} تا ${3:۱۰}:",
      "    `${4:تکرار}` بنویس"
    ],
    "description": "حلقهٔ برای با بازه"
  },
  "برای با گام": {
    "prefix": "برای-گام",
    "body": [
      "برای ${1:متغیر} از ${2:۰} تا ${3:۱۰} گام ${4:۲}:",
      "    ${5:}"
    ],
    "description": "حلقهٔ برای با گام دلخواه"
  },
  "برای-در (پیمایش)": {
    "prefix": "برای-در",
    "body": [
      "برای ${1:عنصر} در ${2:فهرست}:",
      "    ${1:عنصر} بنویس"
    ],
    "description": "پیمایش فهرست با برای-در"
  },
  "تاوقتی": {
    "prefix": "تاوقتی",
    "body": [
      "تاوقتی ${1:شرط} == ${2:درست} باشد:",
      "    ${3:}"
    ],
    "description": "حلقهٔ تاوقتی"
  },
  "بپا-خطا-درنهایت": {
    "prefix": "بپا",
    "body": [
      "بپا:",
      "    ${1:عملیات خطرناک}",
      "خطای‌${2:صفر} بگیر:",
      "    `${3:خطا رخ داد}` بنویس",
      "درنهایت:",
      "    ${4:پاک‌سازی()}"
    ],
    "description": "بلوک بپا/خطا بگیر/درنهایت"
  },
  "خطا بگیر با نام": {
    "prefix": "خطا-بانام",
    "body": [
      "خطای‌${1:صفر} بگیر بانام ${2:err}:",
      "    `${2:err}` بنویس"
    ],
    "description": "گرفتن خطا با نام متغیر"
  },
  "با (with)": {
    "prefix": "با",
    "body": [
      "با بازکردن(${1:`مسیر فایل`}) بانام ${2:ف}:",
      "    ${3:محتوا} = بخوانِ()${2:ف}",
      "    `${3:محتوا}` بنویس"
    ],
    "description": "بلوک با بازکردن (مدیریت منبع)"
  },
  "برو (goroutine)": {
    "prefix": "برو",
    "body": [
      "برو ${1:تابع}(${2:})"
    ],
    "description": "اجرای تابع به‌صورت تارک (goroutine)"
  },
  "کانال": {
    "prefix": "کانال",
    "body": [
      "${1:ch} = کانال(${2:صحیح} و ${3:۱۰})",
      "${1:ch} << ${4:مقدار}",
      "${5:دریافت} = >>${1:ch}",
      "${1:ch} ببند"
    ],
    "description": "ایجاد و استفاده از کانال"
  },
  "پوشش (decorator)": {
    "prefix": "پوشش",
    "body": [
      "پوشش ${1:نام}",
      "تعریف ${2:تابع}(${3:خود}):",
      "    ${4:}"
    ],
    "description": "اعمال پوشش روی تابع"
  },
  "مولد (generator)": {
    "prefix": "مولد",
    "body": [
      "تعریف ${1:تولیدکننده}(${2:خود}):",
      "    برای ${3:ای} در ${4:داده}:",
      "        ${3:ای} بساز"
    ],
    "description": "تابع مولد با بساز"
  },
  "چند مقداری (multiple return)": {
    "prefix": "چندمقداری",
    "body": [
      "${1:نتیجه} و ${2:خطا} = ${3:کاری}()",
      "اگر ${2:خطا} == تهی نباشد:",
      "    ${2:خطا} بده",
      "${1:نتیجه} برگردان"
    ],
    "description": "بازگشت چندمقداری با مدیریت خطا"
  },
  "تأخیری (defer)": {
    "prefix": "تأخیری",
    "body": [
      "${1:پاک‌سازی()} تأخیری"
    ],
    "description": "اجرای تأخیری (defer)"
  },
  "comprehension": {
    "prefix": "کامپرهنشن",
    "body": [
      "${1:نتیجه} = [${2:ای} ** ۲ برای ${2:ای} در ${3:بازه}(۱۰)]"
    ],
    "description": "تولید فهرست با comprehension"
  },
  "pipe": {
    "prefix": "pipe",
    "body": [
      "${1:داده} |> ${2:تابع۱} |> ${3:تابع۲}"
    ],
    "description": "زنجیرهٔ pipe"
  },
  "چاپ ساده": {
    "prefix": "بنویس",
    "body": [
      "`${1:سلام دنیا}` بنویس"
    ],
    "description": "چاپ رشته با بنویس"
  }
}
